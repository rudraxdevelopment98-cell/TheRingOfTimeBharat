# ---------------------------------------------------------------------------
# Bibliosphere — environment variables
# Copy to `.env.local` (or `.env`) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Database & infrastructure ---------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/bibliosphere?schema=public"

# Redis — BullMQ job queues, caching, (optionally) distributed rate limiting.
REDIS_URL="redis://localhost:6379"

# Neo4j — the book/author knowledge graph.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# Meilisearch — full-text search index.
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# --- Authentication (NextAuth v5) ------------------------------------------
# Canonical URL of the deployment. Must match the OAuth redirect URIs.
NEXTAUTH_URL="http://localhost:3000"
# Random 32+ byte secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional) — https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# --- AI ---------------------------------------------------------------------
# Anthropic API key powering summary generation and the book chat.
ANTHROPIC_API_KEY=""

# --- Cloudflare R2 (downloadable summary files) -----------------------------
# S3-compatible object storage; read via @aws-sdk/client-s3 + presigned URLs.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="bibliosphere-downloads"
# Optional public base URL for non-gated assets (e.g. cover images).
R2_PUBLIC_URL=""

# --- Google AdSense ---------------------------------------------------------
# Publisher id, e.g. "ca-pub-0000000000000000".
# When unset, <AdSlot> renders a labelled dev placeholder instead of a real ad.
NEXT_PUBLIC_ADSENSE_CLIENT=""

# --- Payments (paid downloads) ----------------------------------------------
# The `stripe` package is NOT installed yet — the purchase routes are a
# provider-agnostic scaffold. Install it and fill these in to go live.
STRIPE_SECRET_KEY=""
# Signing secret from the Stripe webhook endpoint pointed at
# {NEXTAUTH_URL}/api/purchase/webhook
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
