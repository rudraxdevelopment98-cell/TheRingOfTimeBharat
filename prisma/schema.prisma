generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Era {
  ANCIENT
  MEDIEVAL
  RENAISSANCE
  ENLIGHTENMENT
  MODERN
  CONTEMPORARY
}

enum MaturityRating {
  ALL_AGES
  TEEN
  ADULT
}

enum EditionFormat {
  HARDCOVER
  PAPERBACK
  EBOOK
  AUDIOBOOK
  BRAILLE
}

enum PersonRole {
  AUTHOR
  TRANSLATOR
  EDITOR
  ILLUSTRATOR
  FOREWORD
}

enum CollectionType {
  OFFICIAL
  USER
  AI_GENERATED
}

enum TextDirection {
  LTR
  RTL
  TTB
}

enum UserBookStatus {
  WANT_TO_READ
  READING
  COMPLETED
  ABANDONED
  REFERENCE
}

enum AnnotationType {
  HIGHLIGHT
  NOTE
  BOOKMARK
  QUOTE
}

model Book {
  id                  String   @id @default(cuid())
  title               String
  originalTitle       String?
  slug                String   @unique
  description         String?
  yearWritten         Int?
  yearPublished       Int?
  era                 Era?
  originalLanguage    String?
  wordCountApprox     Int?
  readingTimeMinutes  Int?
  maturityRating      MaturityRating @default(ALL_AGES)
  coverImageUrl       String?
  aiSummaryShort      String?
  aiSummaryMedium     String?
  aiSummaryLong       String?
  aiThemes            String[]
  aiSentiment         String?
  aiReadingLevel      String?
  aiComparableBooks   String[]
  worldcatId          String?
  openLibraryId       String?
  goodreadsId         String?
  wikipediaUrl        String?
  averageRating       Float    @default(0)
  ratingsCount        Int      @default(0)
  viewsCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  authors      BookPerson[]
  editions     Edition[]
  genres       BookGenre[]
  subjects     BookSubject[]
  collections  CollectionBook[]
  userBooks    UserBook[]
  annotations  Annotation[]
  quotes       Quote[]
  reviews      Review[]
}

model Person {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  birthYear         Int?
  deathYear         Int?
  nationality       String?
  languagesWritten  String[]
  bio               String?
  aiBioSummary      String?
  photoUrl          String?
  wikipediaUrl      String?
  websiteUrl        String?
  totalWorks        Int          @default(0)
  averageRating     Float        @default(0)
  createdAt         DateTime     @default(now())

  books    BookPerson[]
  quotes   Quote[]
  editions Edition[] @relation("EditionTranslator")
}

model BookPerson {
  bookId   String
  personId String
  role     PersonRole

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([bookId, personId, role])
}

model Edition {
  id              String        @id @default(cuid())
  bookId          String
  language        String
  publisher       String?
  publishYear     Int?
  isbn10          String?
  isbn13          String?
  pageCount       Int?
  format          EditionFormat @default(PAPERBACK)
  coverImageUrl   String?
  isOriginal      Boolean       @default(false)
  fileUrl         String?
  isPublicDomain  Boolean       @default(false)
  amazonAsin      String?
  priceUsd        Float?
  buyUrl          String?
  createdAt       DateTime      @default(now())

  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  translators Person[]   @relation("EditionTranslator")
  userBooks   UserBook[]
  annotations Annotation[]
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  color String?
  icon  String?

  books BookGenre[]
}

model BookGenre {
  bookId  String
  genreId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
}

model Subject {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  parentId    String?
  description String?
  icon        String?
  color       String?
  level       Int     @default(0)
  bookCount   Int     @default(0)

  parent   Subject?  @relation("SubjectTree", fields: [parentId], references: [id])
  children Subject[] @relation("SubjectTree")
  books    BookSubject[]
}

model BookSubject {
  bookId    String
  subjectId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([bookId, subjectId])
}

model Language {
  code           String    @id
  name           String
  nativeName     String
  script         String?
  direction      TextDirection @default(LTR)
  flagEmoji      String?
  totalBooks     Int       @default(0)
  totalEditions  Int       @default(0)
  isFeatured     Boolean   @default(false)
}

model Collection {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  description         String?
  type                CollectionType @default(USER)
  theme               String?
  coverCollageBookIds String[]
  isFeatured          Boolean        @default(false)
  isPublic            Boolean        @default(true)
  ownerId             String?
  parentCollectionId  String?
  bookCount           Int            @default(0)
  followerCount       Int            @default(0)
  sortOrder           String         @default("manual")
  tags                String[]
  createdAt           DateTime       @default(now())

  owner          User?       @relation(fields: [ownerId], references: [id])
  parent         Collection? @relation("SubCollections", fields: [parentCollectionId], references: [id])
  subCollections Collection[] @relation("SubCollections")
  books          CollectionBook[]
}

model CollectionBook {
  collectionId  String
  bookId        String
  position      Int
  curatorNote   String?
  addedAt       DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([collectionId, bookId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  bio           String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  userBooks    UserBook[]
  annotations  Annotation[]
  reviews      Review[]
  collections  Collection[]
  readingLists ReadingList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBook {
  id              String         @id @default(cuid())
  userId          String
  bookId          String
  status          UserBookStatus @default(WANT_TO_READ)
  editionId       String?
  progressPercent Int            @default(0)
  progressPage    Int?
  userRating      Int?
  userReview      String?
  dateStarted     DateTime?
  dateFinished    DateTime?
  readingNotes    String?
  isFavourite     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id])

  @@unique([userId, bookId])
}

model Annotation {
  id           String         @id @default(cuid())
  userId       String
  bookId       String
  editionId    String?
  type         AnnotationType @default(HIGHLIGHT)
  content      String
  userNote     String?
  chapter      String?
  pageNumber   Int?
  positionCfi  String?
  color        String         @default("yellow")
  isPublic     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition Edition? @relation(fields: [editionId], references: [id])
}

model Quote {
  id         String   @id @default(cuid())
  bookId     String
  personId   String
  text       String
  context    String?
  chapter    String?
  pageNumber Int?
  language   String   @default("en")
  likesCount Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  bookId           String
  title            String?
  body             String
  rating           Int
  containsSpoilers Boolean  @default(false)
  helpfulCount     Int      @default(0)
  language         String   @default("en")
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model ReadingList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  bookCount   Int      @default(0)
  coverBookIds String[]
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
